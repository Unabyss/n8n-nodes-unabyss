{
    "name": "n8n-nodes-unabyss",
    "version": "0.1.0",
    "description": "n8n community node for Unabyss personal memory - query, store, deep research, integrations, and exports via MCP (OAuth2 or API token)",
    "license": "MIT",
    "homepage": "https://unabyss.com",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Dominik Bartosik",
        "email": "dominikbartosik@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Unabyss/n8n-nodes-unabyss.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=22.22 <23"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "node scripts/dev.mjs",
        "setup:n8n": "node scripts/setup-n8n.mjs",
        "dev:n8n-cli": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/UnabyssMcpOAuth2Api.credentials.js",
            "dist/credentials/UnabyssMcpTokenApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Unabyss/Unabyss.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "pnpm": {
        "overrides": {
            "axios@>=1.0.0 <1.20.0": "^1.20.0",
            "brace-expansion@<1.1.21": "^1.1.21",
            "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
            "form-data@>=4.0.0 <4.0.6": "^4.0.6",
            "qs@<6.16.1": "^6.16.1",
            "undici@<6.29.1": "^6.29.1",
            "protobufjs@>=8.0.0 <8.6.6": "^8.6.6",
            "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
            "ip-address@<10.7.4": "^10.7.4",
            "@opentelemetry/core@>=2.0.0 <2.8.0": "^2.8.0",
            "stream-json@<3.6.0": "^3.6.0",
            "basic-ftp@<6.2.1": "^6.2.1",
            "adm-zip@<0.6.1": "^0.6.1",
            "zod@>=4.0.0 <4.6.6": "^4.6.6",
            "uuid@>=11.0.0 <11.1.1": "^11.1.1"
        }
    }
}
